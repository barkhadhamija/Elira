# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# ─── Helpers ──────────────────────────────────────────────────────────────────

# BoringSSL-GRPC 0.0.32 sets '-GCC_WARN_INHIBIT_ALL_WARNINGS' as a per-file
# COMPILER_FLAGS entry. Xcode 16+ clang splits this into '-G' + the rest and
# rejects bare '-G' for arm64-apple-ios targets. Remove it (safe: '-w' is also
# in the same flags and already suppresses all warnings).
def clean_boring_ssl_flags(val)
  return val if val.nil?
  cleaner = ->(s) { s.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '').gsub(/\s+/, ' ').strip }
  if val.is_a?(Array)
    val.reject { |f| f.strip == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
       .map  { |f| cleaner.call(f) }
       .reject(&:empty?)
  elsif val.is_a?(String)
    cleaner.call(val)
  else
    val
  end
end

post_install do |installer|
  # ── 1. Per-target build settings ─────────────────────────────────────────────
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # Fix A: strip -GCC_WARN_INHIBIT_ALL_WARNINGS from BoringSSL target settings
      %w[OTHER_CFLAGS OTHER_SWIFT_FLAGS WARNING_CFLAGS COMPILER_FLAGS].each do |key|
        config.build_settings[key] = clean_boring_ssl_flags(config.build_settings[key])
      end

      # Fix B: suppress gRPC-Core C++ template warning that Xcode 16 raises as error
      # (basic_seq.h:103 -Wmissing-template-arg-list-after-template-kw)
      if %w[gRPC-Core gRPC-C++].include?(target.name)
        existing = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] =
          "#{existing} -Wno-missing-template-arg-list-after-template-kw"
      end

      # Fix C: allow non-modular Firebase.h inside framework modules.
      # firebase_auth 4.x private headers import Firebase.h, which Xcode 16 rejects
      # when use_frameworks! is enabled. Both xcconfig key and build setting needed.
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

      # Fix D: Ensure framework signing for native assets and dynamic pods
      # This resolves the 0xe8008014 (Invalid Signature) error on objective_c.framework
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ""
      config.build_settings['CODE_SIGNING_REQUIRED'] = "YES"
      config.build_settings['CODE_SIGNING_ALLOWED'] = "YES"
      config.build_settings['DEVELOPMENT_TEAM'] = 'GZ77M78RJD'
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
    end
  end

  # ── 2. Per-file COMPILER_FLAGS (PBXBuildFile level) ──────────────────────────
  # CocoaPods propagates the podspec compiler_flags to every PBXBuildFile;
  # this is the primary source of the bare '-G' flag at compile time.
  installer.pods_project.targets.each do |target|
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:files)
      phase.files.each do |build_file|
        next unless build_file.settings&.key?('COMPILER_FLAGS')
        build_file.settings['COMPILER_FLAGS'] =
          clean_boring_ssl_flags(build_file.settings['COMPILER_FLAGS']).to_s
      end
    end
  end

  # ── 3. Patch xcconfig files on disk (needed when use_frameworks! is active) ──
  # With use_frameworks!, Xcode reads module validation from the xcconfig, not
  # only from the .pbxproj. We must write the setting into every xcconfig file.
  support_files_dir = File.join(installer.sandbox.root, 'Target Support Files')
  Dir.glob(File.join(support_files_dir, '**', '*.xcconfig')).each do |xcconfig_path|
    content = File.read(xcconfig_path)
    unless content.include?('CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES')
      content += "\nCLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES\n"
      File.write(xcconfig_path, content)
    end
  end

  # ── 4. Project-level cleanup ──────────────────────────────────────────────────
  installer.pods_project.build_configurations.each do |config|
    config.build_settings.delete('DEAD_CODE_STRIPPING')
  end

  # ── 5. Save the patched Pods project ─────────────────────────────────────────
  installer.pods_project.save
end
